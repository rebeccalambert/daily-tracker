# Copy this to .env and fill in your own value.
# Not a secret — Google's OAuth client IDs for browser apps are meant to be public,
# they're baked into the built JS bundle either way. Kept out of git anyway as standard
# practice for environment-specific config, not because this value needs hiding.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# The deployed backend from the rebuild (Tickets 1-4). Point at
# http://localhost:3001 instead for local backend dev.
VITE_API_BASE_URL=https://daily-tracker-d7su.onrender.com
