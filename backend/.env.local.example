# Template for backend/.env.local — the offline/local-Postgres dev config.
# See the "Offline dev" section in README.md for full setup steps.
# Copy this to .env.local and fill in, or regenerate with the steps below.

# Local Homebrew Postgres, not Neon. Replace `youruser` with your OS username
# (the default superuser role after `brew install postgresql@16`).
DATABASE_URL="postgresql://youruser@localhost:5432/daily_tracker_dev"
DATABASE_URL_UNPOOLED="postgresql://youruser@localhost:5432/daily_tracker_dev"

# Any value works for local-only use — this never needs to match the real
# JWT_SECRET in .env, since local and Neon-backed sessions are never compared.
JWT_SECRET="local-dev-only-not-a-real-secret"

# Generate with: npm run hash-password (pick any password you'll remember —
# it only gates your own local server, never real data).
PASSWORD_HASH="your-generated-hash-here"
