{
  "name": "backend",
  "version": "1.0.0",
  "description": "Express + TypeScript + Prisma API for Daily, replaces Habitica as the source of truth for To-Dos. See ../ITEM_MODEL_SPEC.md for the data model.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "hash-password": "tsx scripts/hash-password.ts",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "test": "vitest run",
    "dev:offline": "dotenv -e .env.local -- tsx watch src/index.ts",
    "prisma:migrate:offline": "prisma migrate deploy --env-file .env.local"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@daily-tracker/shared": "*",
    "@prisma/client": "^6.12.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.12.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
